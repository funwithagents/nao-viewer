# Byte-compiled / caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/

# Virtual environments (uv materializes .venv/ from the lockfile — don't commit it)
.venv/
venv/

# Packaging / build artifacts
build/
dist/
*.egg-info/

# Secrets / local env — live-tier credentials come from the environment, never committed
.env
.env.*

# OS cruft
.DS_Store

# Aldebaran assets: NAO meshes and textures (CC BY-NC-ND 4.0) and anything derived from
# them live only in the user data directory, never in the tree (see the overview spec).
*.dae
*.stl
*.obj
*.msh
*.run
meshes/
texture/
textures/
nao_meshes.xml
